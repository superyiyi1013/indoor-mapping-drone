<launch>
  <!-- X400 onboard MAVROS link: Pixhawk T3/TELEM3 -> onboard computer UART1.
       On this onboard computer, the tested UART device is /dev/ttyTHS0. -->
  <arg name="fcu_url" default="/dev/ttyTHS0:921600"/>
  <arg name="gcs_url" default="udp-b://@14550"/>
  <arg name="pluginlists_yaml" default="$(find x400_bringup)/config/px4_pluginlists_x400.yaml"/>
  <arg name="config_yaml" default="$(find mavros)/launch/px4_config.yaml"/>
  <arg name="x400_config_yaml" default="$(find x400_bringup)/config/x400_mavros_px4_config.yaml"/>
  <arg name="log_output" default="screen"/>
  <arg name="fcu_protocol" default="v2.0"/>
  <arg name="respawn_mavros" default="true"/>

  <node pkg="mavros"
        type="mavros_node"
        name="mavros"
        output="$(arg log_output)"
        respawn="$(arg respawn_mavros)"
        clear_params="true">
    <param name="fcu_url" value="$(arg fcu_url)"/>
    <param name="gcs_url" value="$(arg gcs_url)"/>
    <param name="target_system_id" value="1"/>
    <param name="target_component_id" value="1"/>
    <param name="fcu_protocol" value="$(arg fcu_protocol)"/>

    <rosparam command="load" file="$(arg pluginlists_yaml)"/>
    <rosparam command="load" file="$(arg config_yaml)"/>
    <!-- Drop MAVROS' sample distance_sensor entries before loading the X400
         overlay. The defaults include downward sonar/lidar examples with IDs
         that can be mistaken for the D435i front sensor in QGC. -->
    <rosparam command="delete" param="distance_sensor"/>
    <rosparam command="load" file="$(arg x400_config_yaml)"/>
  </node>
</launch>
